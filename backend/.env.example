# Copy this file to .env and adjust the ESP32 COM port.
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
SENSOR_INTERVAL_MS=180000
SERIAL_RETRY_SECONDS=3
SENSOR_STALE_SECONDS=360
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.REGION.firebasedatabase.app
FIREBASE_RETRY_SECONDS=10
# Use the full path to a service-account JSON file; do not put that file in the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
